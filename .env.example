# LabAutoMate LLM Configuration
# Copy this file to .env and fill in your API key.
# The provider, model and endpoint can also be set in the Streamlit sidebar.

# API Key (your own OpenAI or Anthropic key)
LABAUTOMATE_API_KEY=your-api-key-here

# Endpoint URL (optional)
# OpenAI:    https://api.openai.com/v1
# Anthropic: https://api.anthropic.com
# If the URL does not match the selected provider, the provider's public URL is used.
LABAUTOMATE_ENDPOINT=https://api.openai.com/v1
